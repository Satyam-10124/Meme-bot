{
  "name": "pons-fee-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pons v2 clone-launch / pre-buy / fee-harvest bot for Robinhood Chain (4663) with delegated creator-fee claiming",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pons-bot": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bot": "tsx src/cli.ts"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "viem": "2.21.54"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}

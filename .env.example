# Robinhood Chain mainnet (4663). No secrets belong in this file — copy it to .env.
RPC_URLS=https://rpc.mainnet.chain.robinhood.com

# Source token to clone in the experiment.
SOURCE_TOKEN=0x35b8b49c9c4e7a5d08dc1ba0ea5eac0b9937bc83

# micro = low-funds mainnet profile (0.0005 launch fee + 0.0002 pre-buy).
# standard = the 0.025 ETH pre-buy from the design doc.
PROFILE=micro
# PRE_BUY_ETH=0.0002

# Nothing is broadcast while this is true.
DRY_RUN=true

# Disposable wallet that signs the launch, the pre-buy and the exits.
# LAUNCHER_PRIVATE_KEY=0x...

# Must be 0x0A06b2bDb8daf62fc828a792fc40B0B7538D1A5B — the escrow pays msg.sender, so only
# this key can claim the creator fees. Leave unset to let fees accrue and claim by hand.
# CLAIMER_PRIVATE_KEY=0x...

# Treasury/fee destination. The protocol creator-fee claimer is pinned in code.
TREASURY=0x0A06b2bDb8daf62fc828a792fc40B0B7538D1A5B
LAUNCH_CONFIG_ID=0
CREATOR_TAX_BPS=200
SLIPPAGE_BPS=300
GAS_MULTIPLIER_PERCENT=130
STATE_DIR=.pons-state

SWEEP_THRESHOLD_ETH=0.00002
CLAIM_THRESHOLD_ETH=0.00002
# Launcher ETH kept back after a treasury forward, and the smallest forward worth sending
FORWARD_GAS_RESERVE_ETH=0.0003
FORWARD_MIN_ETH=0.0005

EXIT_STOP_LOSS_BPS=6500
EXIT_RUNG1_MULTIPLE_BPS=20000
EXIT_RUNG1_SELL_BPS=4000
EXIT_RUNG2_MULTIPLE_BPS=30000
EXIT_RUNG2_SELL_BPS=3000
EXIT_TRAIL_ARM_BPS=20000
EXIT_TRAIL_GIVEBACK_BPS=7500
EXIT_GRADUATION_LOCKOUT_BPS=9300
EXIT_TIME_STOP_SECONDS=600
EXIT_TIME_STOP_MULTIPLE_BPS=13000
EXIT_MOMENTUM_FLOW_ETH=0.15
EXIT_MOMENTUM_BUYERS=4
EXIT_MAX_TRANCHE_IMPACT_BPS=150
